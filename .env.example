# Torah Knowledge Graph — Environment Configuration
# Copy to .env and fill in real values

# ─── Neo4j ───
NEO4J_USER=neo4j
NEO4J_PASSWORD=torah-graph-secure

# ─── PostgreSQL ───
POSTGRES_USER=tkg
POSTGRES_PASSWORD=tkg-postgres-secure
POSTGRES_DB=torah_knowledge_graph

# ─── JWT ───
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# ─── AI / Embeddings ───
# Provider: ollama | claude | openrouter | openai
AI_PROVIDER=ollama
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Model selection per provider
CLAUDE_MODEL=claude-sonnet-4-6-20251001
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
