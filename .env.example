# Torah Knowledge Graph — Environment Configuration
# Copy to .env and fill in real values

# ─── Neo4j ───
NEO4J_USER=neo4j
NEO4J_PASSWORD=torah-graph-secure

# ─── PostgreSQL ───
POSTGRES_USER=tkg
POSTGRES_PASSWORD=tkg-postgres-secure
POSTGRES_DB=torah_knowledge_graph

# ─── JWT ───
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# ─── AI / Embeddings ───
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
